#!/bin/bash
# macvs - deployable Debian virtual servers on Apple Silicon Macs.
# QEMU + Hypervisor.framework for the VM, cloud-init for unattended first boot,
# launchd for running it as a service. See README.md.
set -euo pipefail

MACVS_VERSION="0.4.0"

# Find the real location of this script (follows symlinks) so lib/ can be sourced.
_macvs_self() {
  local src="$1" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}
MACVS_BIN_DIR="$(_macvs_self "${BASH_SOURCE[0]}")"
MACVS_ROOT="$(cd "$MACVS_BIN_DIR/.." && pwd)"
MACVS_LIB="$MACVS_ROOT/lib/macvs"

for _f in common image cloudinit qemu launchd deploy commands; do
  # shellcheck disable=SC1090
  . "$MACVS_LIB/$_f.sh"
done
unset _f

main "$@"
